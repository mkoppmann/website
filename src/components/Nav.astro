---
const currentPath = Astro.url.pathname;
const siteName = "@mkoppmann’s mneme";
---

<nav>
  <a href="/" class="nav-brand">{siteName}</a>
  <div class="nav-menu">
    <div class="nav-links">
      <a href="/" class:list={[{ active: currentPath === "/" }]}>Home</a>
      <a
        href="/blog/"
        class:list={[{ active: currentPath.startsWith("/blog/") }]}>Blog</a
      >
      <a
        href="/publications/"
        class:list={[{ active: currentPath === "/publications/" }]}
        >Publications</a
      >
      <a href="/talks/" class:list={[{ active: currentPath === "/talks/" }]}
        >Talks</a
      >
      <a href="/contact/" class:list={[{ active: currentPath === "/contact/" }]}
        >Contact</a
      >
    </div>
    <div class="nav-actions">
      <a
        href="/search/"
        class="nav-search"
        class:list={[{ active: currentPath === "/search/" }]}
        aria-label="Search"
        title="Search"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M11 3a8 8 0 1 0 4.9 14.33l4.88 4.88a1 1 0 0 0 1.42-1.42l-4.88-4.88A8 8 0 0 0 11 3zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z"
            fill="currentColor"></path>
        </svg>
      </a>
      <button
        type="button"
        class="nav-theme"
        data-theme-toggle
        aria-label="Theme: system. Switch to light."
        title="Theme: system. Switch to light."
      >
        <svg
          class="theme-icon theme-icon-system"
          viewBox="0 0 17 17"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M2 2h13v1H2zM1 3h1v9H1zM15 3h1v9h-1zM8 4h1v7H8zM2 12h13v1H2zM8 13h1v2H8zM5 15h7v1H5z"
          ></path>
          <path
            fill="var(--color-theme-sun)"
            d="M5 5h1v1H5zM4 6h3v1H4zM3 7h5v1H3zM4 8h3v1H4zM5 9h1v1H5z"></path>
          <path
            fill="var(--color-theme-moon)"
            d="M11 5h1v1h-1zM10 6h2v1h-2zM9 7h5v1H9zM10 8h3v1h-3zM11 9h1v1h-1z"
          ></path>
        </svg>
        <svg
          class="theme-icon theme-icon-light"
          viewBox="0 0 17 17"
          aria-hidden="true"
        >
          <path
            fill="var(--color-theme-sun)"
            d="M8 0h1v3H8zM2 2h1v1H2zM14 2h1v1h-1zM3 3h1v1H3zM13 3h1v1h-1zM7 4h3v1H7zM5 5h7v2H5zM4 7h9v3H4zM0 8h3v1H0zM14 8h3v1h-3zM5 10h7v2H5zM7 12h3v1H7zM3 13h1v1H3zM13 13h1v1h-1zM2 14h1v1H2zM8 14h1v3H8zM14 14h1v1h-1z"
          ></path>
        </svg>
        <svg
          class="theme-icon theme-icon-dark"
          viewBox="0 0 17 17"
          aria-hidden="true"
        >
          <path
            fill="var(--color-theme-moon)"
            d="M8 2h1v1H8zM5 3h6v1H5zM4 4h4v1H4zM3 5h4v3H3zM2 8h4v1H2zM3 9h4v3H3zM4 12h4v1H4zM5 13h6v1H5zM8 14h1v1H8z"
          ></path>
        </svg>
      </button>
    </div>
  </div>
  <svg
    class="nav-vine"
    height="40"
    shape-rendering="crispEdges"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <path
        id="nav-vine-leaf"
        fill-rule="evenodd"
        d="M13 0h1v2h-1v3h-1v1h-1v1H9v1H7v1H5v1H2v1H0V9h1V5h1V4h2V3h2V2h4V1h3zM2 8h1v1H2zM3 7h1v1H3zM4 6h1v1H4zM5 5h1v1H5zM6 4h2v1H6zM8 3h2v1H8zM10 2h1v1h-1z"
      ></path>
      <pattern
        id="nav-vine-pattern"
        width="544"
        height="40"
        patternUnits="userSpaceOnUse"
        fill="currentColor"
      >
        <path
          class="vine-stem"
          d="M0 "
        ></path>
      </pattern>
    </defs>
    <rect width="100%" height="40" fill="url(#nav-vine-pattern)"></rect>
    <g class="vine-leaves" fill="currentColor">
      <g class="vine-leaf-1">
        <path d="M57 13h1v5h-1z"></path>
        <use href="#nav-vine-leaf" x="56" y="4"></use>
      </g>
      <g class="vine-leaf-2">
        <path d="M132 23h1v4h-1z"></path>
        <use href="#nav-vine-leaf" transform="translate(131 36) scale(1 -1)"
        ></use>
      </g>
      <g class="vine-leaf-3">
        <path d="M197 13h1v5h-1z"></path>
        <use href="#nav-vine-leaf" x="196" y="4"></use>
      </g>
      <g class="vine-leaf-4">
        <path d="M266 23h1v4h-1z"></path>
        <use href="#nav-vine-leaf" transform="translate(265 36) scale(1 -1)"
        ></use>
      </g>
      <g class="vine-leaf-5">
        <path d="M330 13h1v5h-1z"></path>
        <use href="#nav-vine-leaf" x="329" y="4"></use>
      </g>
      <g class="vine-leaf-6">
        <path d="M398 23h1v4h-1z"></path>
        <use href="#nav-vine-leaf" transform="translate(397 36) scale(1 -1)"
        ></use>
      </g>
      <g class="vine-leaf-7">
        <path d="M463 13h1v5h-1z"></path>
        <use href="#nav-vine-leaf" x="462" y="4"></use>
      </g>
      <g class="vine-leaf-8">
        <path d="M511 19h1v8h-1z"></path>
        <use href="#nav-vine-leaf" transform="translate(510 36) scale(1 -1)"
        ></use>
      </g>
      <g class="vine-leaf-9">
        <path d="M578 13h1v7h-1z"></path>
        <use href="#nav-vine-leaf" x="577" y="4"></use>
      </g>
      <g class="vine-leaf-10">
        <path d="M644 18h1v9h-1z"></path>
        <use href="#nav-vine-leaf" transform="translate(643 36) scale(1 -1)"
        ></use>
      </g>
    </g>
  </svg>

  <style>
    nav {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      column-gap: var(--space-xl);
      row-gap: var(--space-md);
      padding: var(--space-lg) 0 calc(var(--space-lg) + var(--space-2xs));
      border-bottom: 0;
      margin-bottom: calc(var(--space-md) + var(--space-2xs));
      container: nav-vine / inline-size;
    }

    .nav-vine {
      position: absolute;
      inset-inline-start: 0;
      bottom: -20px;
      display: block;
      width: 100%;
      height: 40px;
      /* Without a viewBox, pattern units stay at 1 CSS pixel at every width. */
      overflow: hidden;
      color: var(--color-pixel-tree);
      pointer-events: none;
    }

    /* Hide each leaf and its stalk until the complete 14px leaf fits. */
    :where(.vine-leaves > g) {
      display: none;
    }

    @container nav-vine (min-width: 70px) {
      .vine-leaf-1 {
        display: inline;
      }
    }

    @container nav-vine (min-width: 145px) {
      .vine-leaf-2 {
        display: inline;
      }
    }

    @container nav-vine (min-width: 210px) {
      .vine-leaf-3 {
        display: inline;
      }
    }

    @container nav-vine (min-width: 279px) {
      .vine-leaf-4 {
        display: inline;
      }
    }

    @container nav-vine (min-width: 343px) {
      .vine-leaf-5 {
        display: inline;
      }
    }

    @container nav-vine (min-width: 411px) {
      .vine-leaf-6 {
        display: inline;
      }
    }

    @container nav-vine (min-width: 476px) {
      .vine-leaf-7 {
        display: inline;
      }
    }

    @container nav-vine (min-width: 524px) {
      .vine-leaf-8 {
        display: inline;
      }
    }

    @container nav-vine (min-width: 591px) {
      .vine-leaf-9 {
        display: inline;
      }
    }

    @container nav-vine (min-width: 657px) {
      .vine-leaf-10 {
        display: inline;
      }
    }

    .nav-brand {
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      text-decoration: none;
      color: var(--color-heading);
      white-space: nowrap;
    }

    .nav-menu,
    .nav-links {
      display: flex;
      flex: none;
      flex-wrap: wrap;
      max-width: 100%;
      gap: var(--space-xs) var(--space-md);
    }

    .nav-menu {
      align-items: flex-start;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: var(--space-2xs);
    }

    :where(.nav-links a, .nav-search) {
      display: inline-block;
      font-size: 0.8125rem;
      text-decoration: none;
      padding-bottom: var(--space-2xs);
      background-image: linear-gradient(currentColor, currentColor);
      background-repeat: no-repeat;
      background-position: 0 100%;
      background-size: 0 2px;
      transition: background-size 180ms ease;
    }

    :where(.nav-links a:hover, .nav-search:hover),
    :where(.nav-links a.active, .nav-search.active) {
      background-size: 100% 2px;
    }

    :where(.nav-links a:focus-visible, .nav-search:focus-visible) {
      background-size: 100% 2px;
    }

    :where(
      .nav-links a:focus:not(:focus-visible),
      .nav-search:focus:not(:focus-visible)
    ) {
      background-size: 0 2px;
    }

    .nav-search,
    .nav-theme {
      padding-inline: var(--space-2xs);
    }

    .nav-search svg {
      display: block;
      width: 17px;
      height: 17px;
      pointer-events: none;
    }

    .nav-theme {
      align-self: flex-start;
      padding-block: 0 var(--space-2xs);
      border: 0;
      background: none;
      color: var(--color-link);
      font: inherit;
      cursor: pointer;
    }

    .nav-theme:hover {
      color: var(--color-link-hover);
    }

    .theme-icon {
      display: none;
      width: 17px;
      height: 17px;
      shape-rendering: crispEdges;
      pointer-events: none;
    }

    .theme-icon-system {
      display: block;
    }

    :global(html[data-theme="light"]) .theme-icon-system,
    :global(html[data-theme="dark"]) .theme-icon-system {
      display: none;
    }

    :global(html[data-theme="light"]) .theme-icon-light,
    :global(html[data-theme="dark"]) .theme-icon-dark {
      display: block;
    }

    @media (max-width: 480px) {
      nav {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
          "brand actions"
          "links links";
        align-items: center;
        gap: var(--space-xs) var(--space-2xs);
        padding: var(--space-md) 0 calc(var(--space-md) + var(--space-2xs));
      }

      .nav-brand {
        grid-area: brand;
        display: flex;
        align-items: center;
        min-width: 44px;
        min-height: 44px;
      }

      .nav-menu {
        display: contents;
      }

      .nav-links {
        grid-area: links;
        flex-wrap: nowrap;
        justify-content: space-between;
        gap: var(--space-xs);
      }

      .nav-actions {
        grid-area: actions;
      }

      .nav-links a,
      .nav-search,
      .nav-theme {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        min-height: 44px;
        padding: 0;
      }
    }

    @media (max-width: 320px) {
      nav {
        padding: var(--space-sm) 0 calc(var(--space-sm) + var(--space-2xs));
      }

      .nav-brand {
        font-size: 0.75rem;
      }

      .nav-links {
        gap: var(--space-2xs);
      }

      .nav-links a {
        font-size: 0.7rem;
      }
    }
  </style>
</nav>
