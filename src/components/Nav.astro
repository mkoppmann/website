---
const currentPath = Astro.url.pathname;
const siteName = "@mkoppmann’s mneme";
---

<nav>
  <a href="/" class="nav-brand">{siteName}</a>
  <div class="nav-links">
    <a href="/" class:list={[{ active: currentPath === "/" }]}>Home</a>
    <a href="/blog/" class:list={[{ active: currentPath.startsWith("/blog/") }]}
      >Blog</a
    >
    <a
      href="/publications/"
      class:list={[{ active: currentPath === "/publications/" }]}
      >Publications</a
    >
    <a href="/talks/" class:list={[{ active: currentPath === "/talks/" }]}
      >Talks</a
    >
    <a href="/contact/" class:list={[{ active: currentPath === "/contact/" }]}
      >Contact</a
    >
    <div class="nav-actions">
      <a
        href="/search/"
        class="nav-search"
        class:list={[{ active: currentPath === "/search/" }]}
        aria-label="Search"
        title="Search"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M11 3a8 8 0 1 0 4.9 14.33l4.88 4.88a1 1 0 0 0 1.42-1.42l-4.88-4.88A8 8 0 0 0 11 3zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z"
            fill="currentColor"></path>
        </svg>
      </a>
      <button
        type="button"
        class="nav-theme"
        data-theme-toggle
        aria-label="Theme: system. Switch to light."
        title="Theme: system. Switch to light."
      >
        <svg
          class="theme-icon theme-icon-system"
          viewBox="0 0 17 17"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M2 2h13v1H2zM1 3h1v9H1zM15 3h1v9h-1zM8 4h1v7H8zM2 12h13v1H2zM8 13h1v2H8zM5 15h7v1H5z"
          ></path>
          <path
            fill="var(--color-theme-sun)"
            d="M5 5h1v1H5zM4 6h3v1H4zM3 7h5v1H3zM4 8h3v1H4zM5 9h1v1H5z"></path>
          <path
            fill="var(--color-theme-moon)"
            d="M11 5h1v1h-1zM10 6h2v1h-2zM9 7h5v1H9zM10 8h3v1h-3zM11 9h1v1h-1z"
          ></path>
        </svg>
        <svg
          class="theme-icon theme-icon-light"
          viewBox="0 0 17 17"
          aria-hidden="true"
        >
          <path
            fill="var(--color-theme-sun)"
            d="M8 0h1v3H8zM2 2h1v1H2zM14 2h1v1h-1zM3 3h1v1H3zM13 3h1v1h-1zM7 4h3v1H7zM5 5h7v2H5zM4 7h9v3H4zM0 8h3v1H0zM14 8h3v1h-3zM5 10h7v2H5zM7 12h3v1H7zM3 13h1v1H3zM13 13h1v1h-1zM2 14h1v1H2zM8 14h1v3H8zM14 14h1v1h-1z"
          ></path>
        </svg>
        <svg
          class="theme-icon theme-icon-dark"
          viewBox="0 0 17 17"
          aria-hidden="true"
        >
          <path
            fill="var(--color-theme-moon)"
            d="M8 2h1v1H8zM5 3h6v1H5zM4 4h4v1H4zM3 5h4v3H3zM2 8h4v1H2zM3 9h4v3H3zM4 12h4v1H4zM5 13h6v1H5zM8 14h1v1H8z"
          ></path>
        </svg>
      </button>
    </div>
  </div>
  <svg
    class="nav-vine"
    viewBox="0 0 544 40"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <g id="nav-vine-leaf">
        <path d="M0 7h2V5h2V3h2V1h6v2h-2v2H8v2H5v2H2V8H0z"></path>
      </g>
    </defs>
    <path
      class="vine-stem"
      d="M0 20C39 20 52 17 78 17S116 23 145 23S184 17 213 17S249 24 277 23S316 17 344 17S381 23 409 23S448 17 477 17S517 21 544 20"
    ></path>
    <path
      class="leaf-stems"
      d="M57 17v-4m75 10v4m65-10v-4m69 10v4m64-10v-4m68 10v4m65-10v-4m48 6v4"
    ></path>
    <g class="vine-leaves">
      <use href="#nav-vine-leaf" x="50" y="4"></use>
      <use href="#nav-vine-leaf" transform="translate(126 36) scale(1 -1)"
      ></use>
      <use href="#nav-vine-leaf" x="190" y="4"></use>
      <use href="#nav-vine-leaf" transform="translate(260 36) scale(1 -1)"
      ></use>
      <use href="#nav-vine-leaf" x="323" y="4"></use>
      <use href="#nav-vine-leaf" transform="translate(392 36) scale(1 -1)"
      ></use>
      <use href="#nav-vine-leaf" x="456" y="4"></use>
      <use href="#nav-vine-leaf" transform="translate(504 36) scale(1 -1)"
      ></use>
    </g>
  </svg>

  <style>
    nav {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      column-gap: var(--space-xl);
      row-gap: var(--space-md);
      padding: var(--space-lg) 0 calc(var(--space-lg) + var(--space-2xs));
      border-bottom: 1px solid var(--color-border);
      margin-bottom: calc(var(--space-md) + var(--space-2xs));
    }

    .nav-vine {
      position: absolute;
      inset-inline-start: 0;
      bottom: -20px;
      display: block;
      width: 100%;
      height: 40px;
      overflow: visible;
      color: var(--color-pixel-tree);
      pointer-events: none;
    }

    .vine-stem,
    .leaf-stems {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      vector-effect: non-scaling-stroke;
    }

    .vine-leaves {
      fill: currentColor;
      shape-rendering: crispEdges;
    }

    .nav-brand {
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      text-decoration: none;
      color: var(--color-heading);
      white-space: nowrap;
    }

    .nav-links {
      display: flex;
      flex: none;
      flex-wrap: wrap;
      max-width: 100%;
      gap: var(--space-xs) var(--space-md);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: var(--space-2xs);
    }

    :where(.nav-links a) {
      display: inline-block;
      font-size: 0.8125rem;
      text-decoration: none;
      padding-bottom: var(--space-2xs);
      background-image: linear-gradient(currentColor, currentColor);
      background-repeat: no-repeat;
      background-position: 0 100%;
      background-size: 0 2px;
      transition: background-size 180ms ease;
    }

    :where(.nav-links a:hover),
    :where(.nav-links a.active) {
      background-size: 100% 2px;
    }

    :where(.nav-links a:focus-visible) {
      background-size: 100% 2px;
    }

    :where(.nav-links a:focus:not(:focus-visible)) {
      background-size: 0 2px;
    }

    .nav-search,
    .nav-theme {
      padding-inline: var(--space-2xs);
    }

    .nav-search svg {
      display: block;
      width: 17px;
      height: 17px;
      pointer-events: none;
    }

    .nav-theme {
      align-self: flex-start;
      padding-block: 0 var(--space-2xs);
      border: 0;
      background: none;
      color: var(--color-link);
      font: inherit;
      cursor: pointer;
    }

    .nav-theme:hover {
      color: var(--color-link-hover);
    }

    .theme-icon {
      display: none;
      width: 17px;
      height: 17px;
      shape-rendering: crispEdges;
      pointer-events: none;
    }

    .theme-icon-system {
      display: block;
    }

    :global(html[data-theme="light"]) .theme-icon-system,
    :global(html[data-theme="dark"]) .theme-icon-system {
      display: none;
    }

    :global(html[data-theme="light"]) .theme-icon-light,
    :global(html[data-theme="dark"]) .theme-icon-dark {
      display: block;
    }

    @media (max-width: 480px) {
      nav {
        flex-direction: column;
        align-items: flex-start;
        padding: var(--space-md) 0 calc(var(--space-md) + var(--space-2xs));
      }
    }

    @media (max-width: 320px) {
      nav {
        padding: var(--space-sm) 0 calc(var(--space-sm) + var(--space-2xs));
      }

      .nav-brand {
        font-size: 0.75rem;
      }

      .nav-links {
        gap: var(--space-sm);
      }

      .nav-links a {
        font-size: 0.7rem;
      }
    }
  </style>
</nav>
