---
const forestWidth = 2048;
let seed = 0x5eed2026;

const random = () => {
  seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
  return seed / 0x100000000;
};

const forestTrees: {
  x: number;
  y: number;
  size: 16 | 24 | 32;
  face: boolean;
}[] = [];
let x = 0;

while (x < forestWidth) {
  const roll = random();
  const size: 16 | 24 | 32 = roll < 0.38 ? 16 : roll < 0.74 ? 24 : 32;

  if (x + size > forestWidth) break;

  forestTrees.push({ x, y: 32 - size, size, face: false });
  x += size + 2 + Math.floor(random() * 9);
}

let lastFaceX = -120;

for (const tree of forestTrees) {
  if (tree.size !== 16 && tree.x - lastFaceX >= 180) {
    tree.face = true;
    lastFaceX = tree.x;
  }
}
---

<footer>
  <svg
    class="footer-forest"
    height="34"
    shape-rendering="crispEdges"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <path
        id="forest-tree"
        fill="var(--color-pixel-tree)"
        d="M7 0h2v2h2v2h2v2h2v2h1v3H9v5H7v-5H0V8h1V6h2V4h2V2h2z"></path>
      <path
        id="forest-tree-medium"
        fill="var(--color-pixel-tree)"
        d="M11 0h2v3h3v3h3v3h3v3h2v5H13v7h-2v-7H0v-5h2V9h3V6h3V3h3z"></path>
      <path
        id="forest-face"
        fill="var(--color-intro-bg)"
        d="M5 8h1v1H5zM10 8h1v1h-1zM7 10h2v1H7z"></path>
      <path
        id="forest-face-medium"
        fill="var(--color-intro-bg)"
        d="M8 13h2v2H8zM15 13h2v2h-2zM11 16h3v1h-3z"></path>
      <pattern
        id="forest-pattern"
        width={forestWidth}
        height="32"
        patternUnits="userSpaceOnUse"
      >
        {
          forestTrees.map((tree) => (
            <g
              transform={`translate(${tree.x} ${tree.y})${tree.size === 32 ? " scale(2)" : ""}`}
            >
              <use
                href={tree.size === 24 ? "#forest-tree-medium" : "#forest-tree"}
              />
              {tree.face && (
                <use
                  href={
                    tree.size === 24 ? "#forest-face-medium" : "#forest-face"
                  }
                />
              )}
            </g>
          ))
        }
      </pattern>
    </defs>
    <rect width="100%" height="32" fill="url(#forest-pattern)"></rect>
    <rect y="32" width="100%" height="2" fill="currentColor"></rect>
  </svg>
  <p>
    Written by Michael Koppmann, a human –{" "}
    <a href="/rss.xml">RSS feed</a>{" | "}
    <a href="/imprint/#copyright-and-licensing">Licensing</a>{" | "}
    <a href="/imprint/">Imprint</a>{" | "}
    <a href="/privacy/">Privacy</a>
  </p>
</footer>

<style>
  footer {
    position: relative;
    margin-block-start: 34px;
  }

  .footer-forest {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 100%;
    inline-size: 100%;
    block-size: 34px;
    color: var(--color-pixel-tree);
  }
</style>
