---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import { getCollection } from "astro:content";
import Figure from "../components/Figure.astro";
import SpeakerImage from "../assets/devsec2025_speaker.jpg";

const title = "Home of Michael Koppmann";
const description =
  "Michael Koppmann is a security consultant, writer, and speaker working on systems and patterns for secure, resilient, and sustainable software.";

const selectedTalk = (await getCollection("talks")).find(
  (talk) =>
    talk.id ===
    "2026-06-25-illegal-states-are-my-favorite-security-vulnerabilities",
);
const selectedPublication = (await getCollection("publications")).find(
  (publication) =>
    publication.id === "2025-08-22-mit-java-funktional-programmieren",
);
const selectedPost = (await getCollection("blog")).find(
  (post) => post.id === "the-era-of-green-software",
);

if (!selectedTalk || !selectedPublication || !selectedPost) {
  throw new Error(
    "A selected work entry is missing from the content collections.",
  );
}

const selectedWork = [
  {
    label: `Talk · ${selectedTalk.data.venue}`,
    language: selectedTalk.data.language,
    title: selectedTalk.data.title,
    description:
      "In this talk, I look at how types can help prevent security mistakes.",
    href: `/talks/${selectedTalk.id}/`,
  },
  {
    label: `Article · ${selectedPublication.data.venue}`,
    language: selectedPublication.data.language,
    title: selectedPublication.data.title,
    description:
      "I explore functional programming techniques for everyday Java development.",
    href: `/publications/${selectedPublication.id}/`,
  },
  {
    label: "Talk transcript · TEDxTUWien",
    language: "English",
    title: selectedPost.data.title,
    description:
      "The transcript of my talk about the environmental cost of modern software.",
    href: `/blog/${selectedPost.id}/`,
  },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const profilePageJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: title,
  description,
  url: canonicalURL,
  mainEntity: {
    "@type": "Person",
    name: "Michael Koppmann",
    jobTitle: "Information Security Consultant",
    worksFor: {
      "@type": "Organization",
      name: "SBA Research",
      url: "https://www.sba-research.org",
    },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "TU Wien",
      url: "https://www.tuwien.at/",
    },
    url: Astro.site?.href,
    sameAs: [
      "https://github.com/mkoppmann",
      "https://www.sba-research.org/team/michael-koppmann/",
      "https://orcid.org/0000-0001-5699-8226",
      "https://communicating.cypherpunk.observer/shibayashi",
    ],
  },
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <JsonLd schema={profilePageJsonLd} />
  </Fragment>

  <Fragment slot="pageHeader">
    <h1>Michael Koppmann</h1>
    <p class="subtitle">Security consultant, writer, and speaker</p>
    <div class="home-intro">
      <svg
        class="intro-sprout"
        width="32"
        height="24"
        viewBox="0 0 16 12"
        shape-rendering="crispEdges"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M8 5h2v7H8zM3 5h5v1H3zM1 6h7v1H1zM0 7h8v1H0zM2 8h6v1H2zM4 9h4v1H4zM11 1h3v1h-3zM9 2h6v1H9zM9 3h7v1H9zM9 4h6v1H9zM9 5h4v1H9z"
        ></path>
        <path
          fill="var(--color-intro-bg)"
          d="M10 3h1v1h-1zM13 3h1v1h-1zM11 4h2v1h-2z"></path>
      </svg>
      <p class="home-intro-lead">Secure by design. Sustainable in practice.</p>
      <p>
        I work on systems and patterns that make software more resilient and
        easier to get right, hoping to make the world a tiny bit better along
        the way. I share what I learn through writing and talks.{" "}
        <a href="/contact/">Get in touch</a> if you’d like to talk.
      </p>
    </div>
  </Fragment>

  <main id="main-content" data-pagefind-body>
    <section id="about-me">
      <h2>About me</h2>
      <p>
        I’m Michael Koppmann, an information security consultant at <a
          href="https://www.sba-research.org">SBA Research</a
        >. I hold a master’s degree in “Software Engineering and Internet
        Computing” from <a href="https://www.tuwien.at/">TU Wien</a>.
      </p>
      <Figure
        src={SpeakerImage}
        alt="Me speaking at Heise devSec 2025. I’m holding a microphone and looking at the audience."
        caption="Speaking at heise devSec() 2025 · © dpunkt.verlag"
      />
      <p>
        I’m interested in functional programming, privacy-enhancing
        technologies, and open source. Beyond code, I care deeply about
        environmental protection, health and fitness, human rights, and
        continuous self-improvement.
      </p>
    </section>
    <section id="selected-work">
      <h2>Selected work</h2>
      <p>A few things I have written or spoken about:</p>
      <ol class="selected-list">
        {
          selectedWork.map((item) => (
            <li>
              <p class="selected-meta">
                {item.label} · {item.language}
              </p>
              <h3>
                <a href={item.href}>{item.title}</a>
              </h3>
              <p>{item.description}</p>
            </li>
          ))
        }
      </ol>
      <div class="more-work">
        <h3>More work</h3>
        <div class="archive-links">
          <a class="section-nav-link" href="/blog/">All blog posts →</a>
          <a class="section-nav-link" href="/publications/"
            >All publications →</a
          >
          <a class="section-nav-link" href="/talks/">All talks →</a>
        </div>
      </div>
    </section>
    <section id="certifications">
      <h2>Certifications</h2>
      <ul>
        <li>
          Offensive Security Certified Professional (<a
            href="https://www.offensive-security.com/pwk-oscp/">OSCP</a
          >)
        </li>
        <li>
          Certified Information Systems Security Professional (<a
            href="https://www.isc2.org/Certifications/CISSP">CISSP</a
          >)
        </li>
        <li>
          Certified Secure Software Lifecycle Professional (<a
            href="https://www.isc2.org/Certifications/CSSLP">CSSLP</a
          >)
        </li>
        <li>
          GIAC Web Application Penetration Tester (<a
            href="https://www.giac.org/certifications/web-application-penetration-tester-gwapt/"
            >GWAPT</a
          >)
        </li>
      </ul>
    </section>
    <section id="affiliations">
      <h2>Affiliations</h2>
      <ul>
        <li>
          Chapter leader of <a href="https://owasp.org/www-chapter-vienna/"
            >OWASP Vienna</a
          >
        </li>
        <li>
          Member of <a href="https://owasp.org">OWASP</a>
        </li>
        <li>
          Member of <a href="https://c3w.at">Chaos Computer Club Wien</a>
        </li>
        <li>
          Member of <a href="https://applied-privacy.net">Applied Privacy</a>
        </li>
      </ul>
    </section>
    <section id="for-verification">
      <h2>For verification</h2>
      <p>You can verify my identity with these services:</p>
      <ul class="verification-sites">
        <li>
          <a rel="me" href="https://github.com/mkoppmann">GitHub</a>
        </li>
        <li>
          <a rel="me" href="https://www.sba-research.org/team/michael-koppmann/"
            >SBA Research</a
          >
        </li>
        <li>
          <a rel="me" href="https://orcid.org/0000-0001-5699-8226">ORCID ID</a>
        </li>
        <li>
          <a
            rel="me"
            href="https://communicating.cypherpunk.observer/shibayashi"
            >Fediverse</a
          >
        </li>
      </ul>
      <dl class="verification-details">
        <div>
          <dt><abbr title="Pretty Good Privacy">PGP</abbr> fingerprint</dt>
          <dd>
            <code
              ><span>E9B3 3326 8618 0E5E 498C</span>{" "}<span
                >6C97 63CA B0C7 75EB 9C80</span
              ></code
            >
          </dd>
        </div>
        <div>
          <dt>Signal safety numbers</dt>
          <dd>
            <code
              ><span>88630 72114 80083</span>{" "}<span>44420 49604 09486</span
              ></code
            >
          </dd>
        </div>
      </dl>
    </section>
  </main>
</BaseLayout>

<style>
  .home-intro {
    position: relative;
    margin-block: var(--space-md) 0;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--color-intro-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    color: var(--color-footer-text);
    background-color: var(--color-intro-bg);
  }

  .home-intro p {
    margin-block: 0 var(--space-sm);
  }

  .home-intro p:last-of-type {
    margin-block-end: 0;
  }

  .intro-sprout {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: -24px;
    display: block;
    color: var(--color-pixel-tree);
  }

  .home-intro-lead {
    color: var(--color-footer-text);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .home-intro a {
    color: var(--color-footer-link);
    white-space: nowrap;
  }

  .home-intro a:visited {
    color: var(--color-footer-link-visited);
  }

  @media (max-width: 35.99rem) {
    .home-intro {
      margin-block-start: var(--space-sm);
      border-inline: none;
      border-radius: 0;
    }

    .intro-sprout {
      inset-inline-end: var(--space-xs);
    }
  }

  .selected-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .selected-list li {
    margin: 0;
    padding-block: var(--space-lg);
  }

  .selected-list li + li {
    border-block-start: 1px solid var(--color-border);
  }

  .selected-meta {
    margin: 0;
    color: var(--color-caption);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .selected-list h3 {
    margin-block: var(--space-xs);
    font-size: 1.1rem;
  }

  .selected-list li > p:last-child {
    margin: 0;
  }

  .more-work {
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-md);
  }

  .more-work h3 {
    margin-block-end: var(--space-sm);
  }

  .archive-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  #for-verification {
    container: verification / inline-size;
  }

  .verification-sites {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-md);
    margin: 0;
    padding-inline-start: var(--space-lg);
    list-style: disc;
  }

  .verification-sites li {
    margin: 0;
    padding-block: var(--space-2xs);
  }

  .verification-sites a {
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  @container verification (max-width: 16rem) {
    .verification-sites {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .verification-details {
    display: grid;
    gap: var(--space-md);
    margin: var(--space-lg) 0 0;
  }

  .verification-details div,
  .verification-details dd {
    min-inline-size: 0;
  }

  .verification-details dt {
    color: var(--color-caption);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .verification-details dd {
    margin: var(--space-2xs) 0 0;
  }

  .verification-details code {
    display: block;
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-code-bg);
    border-color: var(--color-code-border);
    color: var(--color-code-text);
    font-size: 0.875rem;
    line-height: 1.5;
    white-space: normal;
  }

  .verification-details code span {
    white-space: nowrap;
  }

  @media (max-width: 16rem) {
    .verification-details code span {
      white-space: normal;
    }
  }
</style>
