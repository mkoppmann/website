{
  description = "mkoppmann.at";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    bun2nix = {
      url = "github:nix-community/bun2nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs =
    {
      self,
      nixpkgs,
      bun2nix,
    }:
    let
      inherit (nixpkgs) lib;
      forAllSystems =
        f:
        lib.genAttrs [
          "x86_64-linux"
          "aarch64-linux"
          "x86_64-darwin"
          "aarch64-darwin"
        ] (system: f nixpkgs.legacyPackages.${system} bun2nix.packages.${system}.default);
    in
    {
      packages = forAllSystems (
        pkgs: b2n: {
          default = pkgs.stdenv.mkDerivation {
            pname = "website";
            version = self.shortRev or self.dirtyShortRev;
            src = ./.;

            nativeBuildInputs = [
              b2n.hook
              pkgs.pagefind
            ];
            # bun.nix is regenerated by the postinstall script.
            bunDeps = b2n.fetchBunDeps {
              bunNix = ./bun.nix;
              # sharp ships prebuilt Linux libraries.
              autoPatchElf = pkgs.stdenv.hostPlatform.isLinux;
              nativeBuildInputs = [ pkgs.stdenv.cc.cc.lib ];
            };

            env.ASTRO_TELEMETRY_DISABLED = "1";
            dontUseBunBuild = true;
            dontUseBunCheck = true;
            dontUseBunInstall = true;
            # Pagefind from nixpkgs instead of the prebuilt npm binary.
            buildPhase = ''
              runHook preBuild
              bun run astro build
              pagefind --site dist
              runHook postBuild
            '';
            installPhase = ''
              runHook preInstall
              cp -r dist $out
              runHook postInstall
            '';
          };
        }
      );

      devShells = forAllSystems (
        pkgs: b2n: {
          default = pkgs.mkShell {
            packages = [
              pkgs.bun
              b2n
            ];
          };
        }
      );

      formatter = forAllSystems (pkgs: _: pkgs.nixfmt);
    };
}
