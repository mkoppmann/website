{
  description = "mkoppmann.at";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    # Its own nixpkgs, so its tools come prebuilt from the nix-community cache.
    bun2nix.url = "github:nix-community/bun2nix";
  };

  outputs =
    {
      self,
      nixpkgs,
      bun2nix,
    }:
    let
      inherit (nixpkgs) lib;
      forAllSystems =
        f:
        lib.genAttrs [
          "x86_64-linux"
          "aarch64-linux"
          "x86_64-darwin"
          "aarch64-darwin"
        ] (system: f nixpkgs.legacyPackages.${system} bun2nix.packages.${system}.default);
    in
    {
      packages = forAllSystems (
        pkgs: b2n: {
          default = pkgs.stdenv.mkDerivation {
            pname = "website";
            version = self.shortRev or self.dirtyShortRev;
            src = ./.;

            nativeBuildInputs = [
              b2n.hook
              pkgs.pagefind
            ];
            # bun.nix is regenerated by the postinstall script.
            bunDeps = b2n.fetchBunDeps { bunNix = ./bun.nix; };
            # Real copies in npm's layout: sharp loads libvips from its sibling
            # package relative to its own location.
            bunInstallFlags = [
              "--linker=hoisted"
              "--backend=copyfile"
            ];

            env = {
              ASTRO_TELEMETRY_DISABLED = "1";
            }
            // lib.optionalAttrs pkgs.stdenv.hostPlatform.isLinux {
              # Prebuilt native modules link against libstdc++ and libgcc_s.
              LD_LIBRARY_PATH = lib.makeLibraryPath [
                pkgs.stdenv.cc.cc.lib
                pkgs.stdenv.cc.cc.libgcc
              ];
            };
            dontUseBunBuild = true;
            dontUseBunCheck = true;
            dontUseBunInstall = true;
            # Pagefind from nixpkgs instead of the prebuilt npm binary.
            buildPhase = ''
              runHook preBuild
              bun run astro build
              pagefind --site dist
              runHook postBuild
            '';
            installPhase = ''
              runHook preInstall
              cp -r dist $out
              runHook postInstall
            '';
          };
        }
      );

      devShells = forAllSystems (
        pkgs: _: {
          default = pkgs.mkShell {
            packages = [
              pkgs.bun
              pkgs.pagefind
            ];
          };
        }
      );

      formatter = forAllSystems (pkgs: _: pkgs.nixfmt);
    };
}
